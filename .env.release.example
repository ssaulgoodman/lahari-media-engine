# Copy to .env.release.local. Never commit real tokens.

# npm automation token with publish rights for @ssaulgoodman420/mirage-cli.
NPM_TOKEN=npm_xxx

# Railway account/project token that can set variables and deploy this linked project.
# Prefer a Mirage-scoped token. If your shell already exposes RAILWAY_TOKEN_LAHARI,
# deploy:mirage can use that as a fallback only if it has access to this Railway project.
RAILWAY_TOKEN_MIRAGE=railway_xxx
RAILWAY_TOKEN=railway_xxx
