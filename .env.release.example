# Copy to .env.release.local. Never commit real tokens.

# npm automation token with publish rights for @ssaulgoodman420/mirage-cli.
NPM_TOKEN=npm_xxx

# Railway token scoped to the Mirage project/service.
# deploy:mirage ignores generic Railway tokens and validates the target
# Mirage project/service name before mutating anything.
RAILWAY_TOKEN_MIRAGE=railway_xxx

# Postgres connection string for the Mirage Supabase project, used by the
# future migrate:mirage release step. This must be DB-level migration access;
# the Supabase service role API key is not enough for DDL.
SUPABASE_DB_URL_MIRAGE=postgresql://postgres.xxx:password@aws-...supabase.com:6543/postgres?sslmode=require
